shader_type spatial;
// ============================================================
//  Базовая водная поверхность (вид из-под воды снизу вверх).
//  Версия 0.1 — просто чтобы проверить сеть с нормальной картинкой.
//  TODO (шаг «Вода»): волны получше, каустика на дне, глубина,
//  блики, анимация нормалей. Обсудим вместе и прокачаем.
// ============================================================

render_mode blend_mix, cull_disabled;

void vertex() {
	// Лёгкое покачивание поверхности
	float wave = sin(VERTEX.x * 0.10 + TIME * 1.3) * 0.08
	           + cos(VERTEX.z * 0.08 + TIME * 0.9) * 0.08;
	VERTEX.y += wave;
}

void fragment() {
	// Плёнка воды: полупрозрачная, зеленовато-голубая
	ALBEDO = vec3(0.08, 0.42, 0.45);
	ALPHA = 0.45;
	ROUGHNESS = 0.25;
	METALLIC = 0.0;
	// Лёгкое свечение ближе к поверхности (вид снизу)
	float depth = clamp(1.0 - abs(EYE.y - VERTEX.y) / 30.0, 0.0, 1.0);
	EMISSION = vec3(0.04, 0.14, 0.16) * depth;
}
